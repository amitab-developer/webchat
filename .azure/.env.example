# Local runtime
LOG_LEVEL="Debug"
WEBCHAT_DEV_MODE="true"

# Optional Azure identity settings for DefaultAzureCredential / managed identity.
AZURE_CLIENT_ID=""
AZURE_TENANT_ID=""
AZURE_SUBSCRIPTION_ID=""

# Azure OpenAI / Foundry
AZURE_FOUNDRY_API_ENDPOINT="https://<openai-resource-name>.cognitiveservices.azure.com/"
AZURE_FOUNDRY_RUNTIME_API_VERSION="2024-12-01-preview"
AZURE_FOUNDRY_CHAT_MODEL_DEPLOYMENT="<deployment-name-or-json>"
AZURE_FOUNDRY_API_KEY=""

# Cosmos DB. When omitted or unavailable, the app falls back to data/local-store.json.
AZURE_COSMOS_ENDPOINT=""
AZURE_COSMOS_KEY=""
AZURE_COSMOS_WEBCHAT_DATABASE_NAME="webchat_rag"
AZURE_COSMOS_WEBCHAT_SESSIONS_CONTAINER_NAME="chat_sessions"
AZURE_COSMOS_WEBCHAT_MESSAGES_CONTAINER_NAME="chat_messages"
AZURE_COSMOS_WEBCHAT_DOCUMENTS_CONTAINER_NAME="webchat_documents"

# Upload and chat limits
CHAT_MAX_MESSAGE_LENGTH="12000"
SESSION_UPLOAD_MAX_FILE_COUNT="10"
SESSION_UPLOAD_MAX_FILE_SIZE_BYTES="26214400"
SESSION_UPLOAD_SUPPORTED_EXTENSIONS=".txt,.md,.csv,.json,.pdf,.docx"
